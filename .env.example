# AgentForge environment configuration

# Server port
PORT=3000

# Environment variable descriptions (for quick reference in docs)
# DISPATCH_ENABLED: Enable or disable the Dispatch integration (default: true)
# DISPATCH_CONTROLLER_URL: URL to the Dispatch controller (default: https://controller.example.com)
# DATABASE_*: Database configuration. Supports SQLite, MySQL, PostgreSQL

# Dispatch settings
# DISPATCH_ENABLED enables the dispatch controller integration
DISPATCH_ENABLED=true
# DISPATCH_CONTROLLER_URL is the endpoint of your DISPATCH controller
DISPATCH_CONTROLLER_URL=https://controller.example.com

# Database settings
DATABASE_PATH=./db.sqlite3
DATABASE_TYPE=sqlite
DATABASE_PORT=
DATABASE_HOST=
DATABASE_NAME=agentforge
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# Secret keys and tokens
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=/root/.agentforge/secrets
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

# Logging
DEBUG=false
LOG_PATH=/var/log/agentforge
LOG_LEVEL=info

# Storage
STORAGE_TYPE=local
BLOB_STORAGE_PATH=/data/blob
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# App and auth
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=REPLACE_ME
JWT_REFRESH_TOKEN_SECRET=REPLACE_ME
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# Queue/Redis
MODE=production
QUEUE_NAME=default
REDIS_URL=redis://localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional TLS/SSL
DATABASE_SSL_KEY_BASE64=

# DISPATCH variables for reference in compose
DISPATCH_CONTROLLER_URL=${DISPATCH_CONTROLLER_URL}
