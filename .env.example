##############################################
# AgentForge Docker / Docker-Compose env vars
##############################################

# Server port the app will listen on (default 3000)
PORT=3000

# Dispatch configuration
# Enable dispatch mode for distributed agent execution
DISPATCH_ENABLED=true
# URL of the dispatch controller service
DISPATCH_CONTROLLER_URL=http://localhost:8080

# DATABASE CONFIG
# Path to database files (for sqlite) or connection string (for others)
DATABASE_PATH=./data/db.sqlite
DATABASE_TYPE=sqlite
# Optional: host/port if using remote DBs
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=agentforge
DATABASE_USER=agent
DATABASE_PASSWORD=secret
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# SECRET KEYS (-storage/encryption)
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=./secret
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=your-access-key
SECRETKEY_AWS_SECRET_KEY=your-secret-key
SECRETKEY_AWS_REGION=us-east-1
SECRETKEY_AWS_NAME=default

# LOGGING
DEBUG=false
LOG_PATH=./logs
LOG_LEVEL=info

# STORAGE
STORAGE_TYPE=local
BLOB_STORAGE_PATH=./blobs
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# AUTH PARAMETERS
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=change-me
JWT_REFRESH_TOKEN_SECRET=change-me
JWT_ISSUER=agentforge
JWT_AUDIENCE=agent
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# QUEUE CONFIGURATION
MODE=production
QUEUE_NAME=default
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Additional
DATABASE_SSL=true

# Optional: Sudo or other envs used by the deployment tooling
DEBUG_DASHBOARD=false
