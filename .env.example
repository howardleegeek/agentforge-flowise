## Oyster Dispatch integration example
# Enable/disable dispatch bridge
DISPATCH_ENABLED=true

# URL of the Oyster Dispatch controller (HTTP API)
# e.g. http://dispatch-controller.local/api
DISPATCH_CONTROLLER_URL=https://dispatcher.example/api

# Optional: override controller timeout in ms if you have a custom proxy/wrapper
# DISPATCH_CONTROLLER_TIMEOUT_MS=5000
