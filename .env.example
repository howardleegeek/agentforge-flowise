# AgentForge environment example for docker-compose based deployment
# This file documents all supported environment variables used by docker-compose.yml
# Do not commit real secrets here; this is just a template for users.

# Server port
PORT=3000

# Dispatch control
# Enable/disable the dispatcher at runtime
DISPATCH_ENABLED=true
# URL of the central dispatch controller (the API the agent talks to)
DISPATCH_CONTROLLER_URL=https://dispatch.example.com

# Database configuration (supporting SQLite/MySQL/Postgres via env vars in compose)
DATABASE_PATH=./data/database.sqlite
DATABASE_TYPE=sqlite
DATABASE_PORT=
DATABASE_HOST=
DATABASE_NAME=agentforge
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# Secret storage and keys
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=/root/.agentforge/secretkey
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

# Debug and logging
DEBUG=false
LOG_PATH=/var/log/agentforge
LOG_LEVEL=info

# Storage and blob settings
STORAGE_TYPE=local
BLOB_STORAGE_PATH=/data/blob
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# App and authentication
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# Queue and Redis
MODE=production
QUEUE_NAME=agentforge
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Misc
SECRETKEY_AWS_REGION=

# ARM and build metadata (for reference only)
# Note: This file is not used to build; it is consumed by docker-compose at runtime.
