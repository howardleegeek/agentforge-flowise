# AgentForge Docker deployment environment variables
# Core server
PORT=3000
DISPATCH_ENABLED=true
# Production/Controller URL for dispatch controller
DISPATCH_CONTROLLER_URL=https://controller.example.com

# Database configuration
# Choose one of sqlite (default), mysql, or postgres
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/database.sqlite
DATABASE_PORT=5432
DATABASE_HOST=localhost
DATABASE_NAME=agentforge
DATABASE_USER=agentforge
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# Secret keys and credentials
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=/root/.agentforge/secret.key
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

# Logging
DEBUG=false
LOG_PATH=/var/log/agentforge
LOG_LEVEL=info

# Storage
STORAGE_TYPE=local
BLOB_STORAGE_PATH=/var/lib/agentforge/blob
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# App and JWT
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=changeme
JWT_REFRESH_TOKEN_SECRET=changeme
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# Queue and Redis
MODE=production
QUEUE_NAME=default
REDIS_URL=redis://localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Additional variables may be needed depending on deployment
