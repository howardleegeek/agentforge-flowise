# AgentForge Docker deployment environment example
# Do not commit secrets in production. This file is for local/dev usage.

# Server port
PORT=3000

# Dispatch/configuration toggles
DISPATCH_ENABLED=true
DISPATCH_CONTROLLER_URL=https://dispatcher.example.com

# Database configuration
DATABASE_PATH=./data/agentforge.db
DATABASE_TYPE=sqlite
DATABASE_PORT=
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# Secrets and keys
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=/root/.agentforge/secret
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

# Logging
DEBUG=false
LOG_PATH=./logs
LOG_LEVEL=info

# Storage and blob
STORAGE_TYPE=local
BLOB_STORAGE_PATH=./blobs
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# App and auth
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=change-me
JWT_REFRESH_TOKEN_SECRET=change-me
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# Queue & Redis
MODE=production
QUEUE_NAME=agentforge
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Production helpers (optional)
DISPATCH_ENABLED_PROD=true
DISPATCH_CONTROLLER_URL_PROD=https://prod.dispatch.example.com

# Variable descriptions (explanations for maintainers)
# DISPATCH_ENABLED: enable/disable Dispatch coordination in AgentForge
# DISPATCH_CONTROLLER_URL: base URL for the Dispatch controller service
# DATABASE_*: database connection/configuration details
# SECRETKEY_*: storage of sensitive secret keys
# APP_URL: public URL of the app
# JWT_*: JSON Web Token related secrets and claims
# REDIS_*: Redis connection settings

# Note: The following variables mirror those in the base docker-compose.yml for clarity.
