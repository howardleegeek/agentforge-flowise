# AgentForge Docker Compose environment example
# Copy this file to .env to customize configuration for local development.

# General
PORT=3000
APP_URL=http://localhost:3000

# Dispatch configuration
# DISPATCH_ENABLED toggles agent dispatch feature on/off
DISPATCH_ENABLED=true
# DISPATCH_CONTROLLER_URL is the controller endpoint the agent talks to (required by dispatch)
# DISPATCH_CONTROLLER_URL
DISPATCH_CONTROLLER_URL=https://controller.example.com

# Database configuration (supported: sqlite, mysql, postgres)
DATABASE_PATH=./data/db.sqlite
DATABASE_TYPE=sqlite
DATABASE_PORT=3306
DATABASE_HOST=localhost
DATABASE_NAME=agentforge
DATABASE_USER=root
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# Secrets
SECRETKEY_STORAGE_TYPE=local
SECRETKEY_PATH=/root/.agentforge/secret
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

# Logging
DEBUG=false
LOG_PATH=./logs
LOG_LEVEL=info

# Storage
STORAGE_TYPE=local
BLOB_STORAGE_PATH=./blobs
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# Authentication
APP_URL_BASE=http://localhost
JWT_AUTH_TOKEN_SECRET=changeme
JWT_REFRESH_TOKEN_SECRET=changeme
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=20160

# Queue & cache
MODE=production
QUEUE_NAME=default
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
