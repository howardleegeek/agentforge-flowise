# AgentForge environment variables (example)
# Basic server config
PORT=3000
DISPATCH_ENABLED=false
DISPATCH_CONTROLLER_URL=http://localhost:8080

# Database configuration (SQLite/MySQL/Postgres supported by app)
DATABASE_PATH=./data/db.sqlite
DATABASE_TYPE=sqlite
DATABASE_PORT=
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# Secret keys and credentials
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=/root/.agentforge/secret
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

# Logging
DEBUG=false
LOG_PATH=./logs
LOG_LEVEL=info

# Storage configuration
STORAGE_TYPE=local
BLOB_STORAGE_PATH=./data/blob
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# Authentication / tokens
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# Queue / Redis
MODE=production
QUEUE_NAME=default
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
