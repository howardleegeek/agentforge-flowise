# AgentForge Environment Configuration
# Copy this file to .env and update with your values

# Core server
PORT=3000

############################################################################################################
########################################### DISPATCH CONFIGURATION #########################################
############################################################################################################

# Enable dispatch mode for distributed agent execution
# Set to true to enable AgentForge Dispatch integration
DISPATCH_ENABLED=false

# Production/Controller URL for dispatch controller
# Required when DISPATCH_ENABLED=true: URL of the central dispatch controller service
DISPATCH_CONTROLLER_URL=http://localhost:8080

# Production override for dispatch switch in docker-compose.prod.yml
DISPATCH_ENABLED_PROD=true

# DISPATCH_CONTROLLER_URL production override in docker-compose.prod.yml
DISPATCH_CONTROLLER_URL_PROD=https://controller-prod.example.com

############################################################################################################
############################################## DATABASE ####################################################
############################################################################################################

# Database configuration
# Choose one of sqlite (default), mysql, or postgres
DATABASE_TYPE=sqlite
DATABASE_PATH=/root/.agentforge/database.sqlite
DATABASE_PORT=5432
DATABASE_HOST=localhost
DATABASE_NAME=agentforge
DATABASE_USER=agentforge
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

############################################################################################################
############################################## SECRET KEYS #################################################
############################################################################################################

# Secret keys and credentials
SECRETKEY_STORAGE_TYPE=local
SECRETKEY_PATH=/root/.agentforge
FLOWISE_SECRETKEY_OVERWRITE=false
# For AWS secret storage:
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

############################################################################################################
############################################## LOGGING ######################################################
############################################################################################################

DEBUG=false
LOG_PATH=/var/log/agentforge
LOG_LEVEL=info

# Storage
STORAGE_TYPE=local
BLOB_STORAGE_PATH=/root/.agentforge/storage
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# App and JWT
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=changeme
JWT_REFRESH_TOKEN_SECRET=changeme
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

############################################################################################################
############################################# Queue and Redis #############################################
############################################################################################################

MODE=production
QUEUE_NAME=default
REDIS_URL=redis://localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Additional variables may be needed depending on deployment
