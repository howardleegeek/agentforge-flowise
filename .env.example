# AgentForge deployment environment example
# Core server configuration
PORT=3000
DISPATCH_ENABLED=true
DISPATCH_CONTROLLER_URL=https://controller.example.com
# The URL of the Dispatch Controller that coordinates task execution

# Database configuration (choose one backend by leaving others empty or provide credentials accordingly)
# SQLite (file-based)
DATABASE_PATH=./data/database.sqlite
# MySQL
#DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=agentforge
DATABASE_USER=root
#DATABASE_PASSWORD=changeme
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=./secrets
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=us-east-1
SECRETKEY_AWS_NAME=

# Logging
DEBUG=false
LOG_PATH=./logs
LOG_LEVEL=info

# Storage
STORAGE_TYPE=local
BLOB_STORAGE_PATH=./blob
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=us-east-1
S3_ENDPOINT_URL=

# Auth
APP_URL=http://localhost:${PORT}
JWT_AUTH_TOKEN_SECRET=changeme
JWT_REFRESH_TOKEN_SECRET=changeme
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# Queue
MODE=production
QUEUE_NAME=default
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker/Deployment
# DISPATCH_CONTROLLER_URL documented above
