# Environment variables for running AgentForge via Docker Compose
# This file documents all configurable environment variables used by docker-compose.yml

# Server port
PORT=3000

# Dispatch controls
DISPATCH_ENABLED=true
DISPATCH_CONTROLLER_URL=http://localhost:3000/api

# Database config
DATABASE_PATH=./data/db.sqlite3
DATABASE_TYPE=sqlite
DATABASE_PORT=5432
DATABASE_HOST=localhost
DATABASE_NAME=agentforge
DATABASE_USER=agentforge
DATABASE_PASSWORD=secret
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# Secrets and keys
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=/root/.agentforge/secret
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=your-access-key
SECRETKEY_AWS_SECRET_KEY=your-secret-key
SECRETKEY_AWS_REGION=us-east-1
SECRETKEY_AWS_NAME=default

# Logging
DEBUG=false
LOG_PATH=/var/log/agentforge
LOG_LEVEL=info

# Storage
STORAGE_TYPE=filesystem
BLOB_STORAGE_PATH=/data/blob
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=

# App and JWT
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=changeme
JWT_REFRESH_TOKEN_SECRET=changeme
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440

# Queue and Redis
MODE=production
QUEUE_NAME=default
REDIS_URL=redis://localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Misc
DATABASE_SSL=true

# ARM64 / AMD64 compatibility note
# This deployment supports both arm64 and amd64 using standard Docker images.
