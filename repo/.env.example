###############################################
# Environment configuration for AgentForge Docker
# This file documents required and optional environment variables
###############################################

# Server port exposed by the app inside the container
PORT=3000

# DISPATCH (optional)
# Enable or disable dispatch mode for distributed agent execution
DISPATCH_ENABLED=false
# URL of the dispatch controller service (the central orchestrator)
DISPATCH_CONTROLLER_URL=http://localhost:8080

# DATABASE CONFIGURATION
# Path or connection details for the database used by AgentForge
DATABASE_PATH=
# Type of database: sqlite, mysql, postgres, etc.
DATABASE_TYPE=sqlite
# If using a network DB, configure host/port/name/user/password
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_KEY_BASE64=

# SECRET KEYS / STORAGE
SECRETKEY_STORAGE_TYPE=file
SECRETKEY_PATH=/root/.agentforge/secret
FLOWISE_SECRETKEY_OVERWRITE=false
SECRETKEY_AWS_ACCESS_KEY=
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=

# DEBUG / LOGGING
DEBUG=false
LOG_PATH=/var/log/agentforge
LOG_LEVEL=info
LOG_SANITIZE_BODY_FIELDS=false
LOG_SANITIZE_HEADER_FIELDS=false

# STORAGE / BLOB
STORAGE_TYPE=file
BLOB_STORAGE_PATH=/data/blob
S3_STORAGE_BUCKET_NAME=
S3_STORAGE_ACCESS_KEY_ID=
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
GOOGLE_CLOUD_STORAGE_CREDENTIAL=
GOOGLE_CLOUD_STORAGE_PROJ_ID=
GOOGLE_CLOUD_STORAGE_BUCKET_NAME=
GOOGLE_CLOUD_UNIFORM_BUCKET_ACCESS=false

# AUTHENTICATION / TOKEN
APP_URL=http://localhost:3000
JWT_AUTH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_TOKEN_EXPIRY_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=1440
EXPIRE_AUTH_TOKENS_ON_RESTART=false
EXPRESS_SESSION_SECRET=
PASSWORD_RESET_TOKEN_EXPIRY_IN_MINS=30
PASSWORD_SALT_HASH_ROUNDS=10
TOKEN_HASH_SECRET=
SECURE_COOKIES=false

# EMAIL
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
ALLOW_UNAUTHORIZED_CERTS=false
SENDER_EMAIL=

# ENTERPRISE / LICENSE
LICENSE_URL=
FLOWISE_EE_LICENSE_KEY=
OFFLINE=false
INVITE_TOKEN_EXPIRY_IN_HOURS=24
WORKSPACE_INVITE_TEMPLATE_PATH=

# METRICS / LOGGING
POSTHOG_PUBLIC_API_KEY=
ENABLE_METRICS=false
METRICS_PROVIDER=OpenTelemetry
METRICS_INCLUDE_NODE_METRICS=true
METRICS_SERVICE_NAME=agentforge
METRICS_OPEN_TELEMETRY_METRIC_ENDPOINT=
METRICS_OPEN_TELEMETRY_PROTOCOL=grpc
METRICS_OPEN_TELEMETRY_DEBUG=false

# PROXY / NETWORK
GLOBAL_AGENT_HTTP_PROXY=
GLOBAL_AGENT_HTTPS_PROXY=
GLOBAL_AGENT_NO_PROXY=

# QUEUE / REDIS
MODE=production
QUEUE_NAME=default
QUEUE_REDIS_EVENT_STREAM_MAX_LEN=10000
WORKER_CONCURRENCY=4
REMOVE_ON_AGE=0
REMOVE_ON_COUNT=100
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CERT=
REDIS_KEY=
REDIS_CA=
REDIS_KEEP_ALIVE=60
ENABLE_BULLMQ_DASHBOARD=false

# SECURITY
CUSTOM_MCP_SECURITY_CHECK=true
CUSTOM_MCP_PROTOCOL=https
HTTP_DENY_LIST=
TRUST_PROXY=false

# BOILERPLATE / NOTES
# This file intentionally keeps secrets out of version control.
# Copy this to .env and fill in values appropriate for your environment.
